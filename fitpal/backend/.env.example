# Backend secrets — NEVER commit the real .env, never put these in the mobile app.
PORT=3000

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# USDA FoodData Central key (free) — https://fdc.nal.usda.gov/api-key-signup.html
# Only needed here if you choose to proxy USDA through the backend instead of
# calling it directly from the app (see src/services/nutrition/usdaService.ts note).
USDA_FDC_API_KEY=your-usda-key-here

# Supabase service-role key (bypasses RLS) — only if the backend needs to write
# shared data like the barcode_products cache. Get from Supabase project settings > API.
# NEVER expose this key to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co
