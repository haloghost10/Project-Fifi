# Mobile app (Expo) — safe to expose on-device, these are PUBLIC keys only
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# URL of the backend proxy in backend/ (see backend/.env.example for its secrets)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# USDA FoodData Central key (free) — https://fdc.nal.usda.gov/api-key-signup.html
EXPO_PUBLIC_USDA_FDC_API_KEY=USDA_FDC_API_KEY_HERE